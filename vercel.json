{
  "headers": [
    {
      "source": "/data/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=60, must-revalidate"
        }
      ]
    },
    {
      "source": "/.data/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "twenty6.net"
        }
      ],
      "destination": "https://26awake.net/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.twenty6.net"
        }
      ],
      "destination": "https://26awake.net/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.26awake.net"
        }
      ],
      "destination": "https://26awake.net/:path*",
      "permanent": true
    },
    {
      "source": "/watch.html",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/music.html",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/gifs.html",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/anime.html",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/nothing.html",
      "destination": "/",
      "permanent": false
    }
  ]
}
