{
  "headers": [
    {
      "source": "/data/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=60, must-revalidate"
        }
      ]
    },
    {
      "source": "/.data/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/watch.html",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/music.html",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/gifs.html",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/anime.html",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/nothing.html",
      "destination": "/",
      "permanent": false
    }
  ]
}
